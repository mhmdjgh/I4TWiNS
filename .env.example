# Copy to .env and fill in your key. Only LLM_API_KEY is required.

# Free key from https://openrouter.ai/keys (OPENROUTER_API_KEY is accepted too)
LLM_API_KEY=

# Any OpenAI-compatible endpoint works; the defaults target OpenRouter's free tier.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it:free
LLM_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free
LLM_TEMPERATURE=0.2

# Ask for JSON output on structured calls (set false if the provider rejects response_format)
LLM_JSON_MODE=true
# Some providers reject the "system" role; set false to fold system prompts into the user turn
LLM_SYSTEM_ROLE=true

# Routing
MAX_SKILLS_PER_REQUEST=2
CLARIFY_BELOW_CONFIDENCE=0.4
SHORTLIST_THRESHOLD=8
SHORTLIST_TOP_K=6

# Context budget (estimated tokens)
CONTEXT_WINDOW=16000
MAX_OUTPUT_TOKENS=1200
TOTAL_OUTPUT_BUDGET=2000
ROUTER_EXCERPT_TOKENS=700
CHUNK_TOKENS=2500
